{
  "name": "aem-cloud-manager-companion",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "description": "Development checks for the AEM Cloud Manager Companion Chrome extension",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm test && npm run site:check",
    "site:serve": "node scripts/serve-site.mjs",
    "site:build": "node scripts/build-site.mjs",
    "site:check": "node scripts/check-site.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0"
  }
}
